// Small controls more than one surface uses, both looks (compare the QML in
// shell/common: KeyCombo.qml, IconButton.qml, Spinner.qml, MaterialShape.qml,
// and the search fields of the emoji picker and clipboard panel).

import { FocusRing } from "focus.slint";
import { Theme, Ease } from "theme.slint";
import { SymIcon } from "symbols.slint";

// The kit: one shared set of controls (a surface uses these, not a copy of
// its own): IconButton, PillButton and TextButton, Switch, Segmented,
// TextField and SearchField, MenuRow, Spinner and Busy, ScrollIndicator,
// Keycap and KeyHint, StateShape (the focus ring: focus.slint). Their icons are SymIcon's: a
// Phosphor glyph, or in Material the Material Symbol for it (on a surface
// whose main.slint exports Symbols and fills Symbols.of; without it the
// Phosphor glyph stays).

// A ghost icon button (IconButton.qml): transparent, a fill on hover, darker
// pressed. Material: round, a state layer in the icon's colour, squaring off
// while pressed. A press squishes it (Glass 0.95) or swells it (Material
// 1.06, press bounce; ElasticControl.qml); with Reduce motion it jumps.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> fill;
    in property <bool> bold;
    in property <color> icon-color: Theme.secondary;
    in property <length> icon-size: 16px;
    in property <string> label;
    // (off: greyed, no hover or press look, not pressable)
    in property <bool> enabled: true;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    width: 28px;
    height: 28px;
    opacity: enabled ? 1 : Theme.disabled-alpha;
    border-radius: Theme.material ? (touch.pressed ? min(8px, self.height / 2) : self.height / 2) : Theme.radius-control - 2px;
    background: Theme.material ? (touch.pressed ? Theme.m3-on-surface-variant.with-alpha(0.1) : touch.has-hover ? Theme.m3-on-surface-variant.with-alpha(0.08) : transparent)
        : touch.pressed ? Theme.fill-pressed : touch.has-hover ? Theme.fill : transparent;
    animate background { duration: Theme.hover; }
    animate border-radius { duration: Theme.move-fast; easing: Ease.out-cubic; }
    // (Glass: spring 6 / damping 0.37, 325 ms spring(0.4); Material:
    // springPress 7.5 / 0.3, 290 ms spring(0.57))
    transform-scale: touch.pressed ? (Theme.material ? (Theme.press-bounce ? 1.06 : 1) : 0.95) : 1;
    animate transform-scale { duration: Theme.motion(Theme.material ? 290ms : 325ms); easing: Theme.material ? spring(0.57) : spring(0.4); }
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { clicked(); } }
    // (Tab reaches it, Enter or Space presses it; off: a list whose own keys
    // reach the button, so Tab doesn't stop on every row's)
    in property <bool> focusable: true;
    forward-focus: keys;
    keys := FocusScope {
        // (a click goes to what's under it; the ring is the keyboard's)
        focus-on-click: false;
        enabled: root.enabled;
        focus-on-tab-navigation: root.focusable;
        property <bool> keyed;
        focus-gained(r) => { self.keyed = r == FocusReason.tab-navigation; }
        key-pressed(e) => {
            if !e.repeat && (e.text == " " || e.text == Key.Return) {
                self.keyed = true;
                root.clicked();
                return accept;
            }
            reject
        }
    }
    SymIcon {
        text: icon;
        fill: root.fill;
        bold: root.bold;
        color: icon-color;
        font-size: icon-size;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            keys.keyed = false;
            root.clicked();
        }
    }
    FocusRing { shown: keys.has-focus && keys.keyed; radius: root.border-radius; }
}

// A search field: magnifier, the text, a placeholder, and (clearable) a
// clear button. Keys reach `key` first (return true: handled), so a panel
// can drive its list from the field, as the QML panels do.
// Material: a pill in surface container high; Glass: a fill, outlined in the
// accent while focused.
export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in property <bool> clearable: true;
    in-out property <string> text <=> input.text;
    out property <bool> focused: input.has-focus;
    // the caret and the selection's other end, as byte offsets into `text`
    out property <int> caret: input.cursor-position-byte-offset;
    out property <int> anchor: input.anchor-position-byte-offset;
    callback edited(string);
    callback key(KeyEvent) -> bool;

    public function focus-field() {
        input.focus();
    }
    public function set-text(t: string) {
        input.text = t;
    }

    height: 36px;
    border-radius: Theme.material ? self.height / 2 : Theme.radius-control;
    background: Theme.material ? Theme.m3-surface-container-high : Theme.fill;
    // (focused: outlined in both looks, Material 2 px primary, Glass 1 px accent)
    border-width: Theme.material ? (input.has-focus ? 2px : 0) : 1px;
    border-color: input.has-focus ? (Theme.material ? Theme.m3-primary : Theme.accent) : transparent;

    SymIcon {
        x: Theme.material ? 12px : 10px;
        width: Theme.material ? 20px : 16px;
        text: "\u{e30c}";
        font-size: 16px;
        color: Theme.tertiary;
    }
    Rectangle {
        x: Theme.material ? 40px : 34px;
        width: parent.width - self.x - (clear-keys.visible ? 36px : Theme.material ? 16px : 10px);
        clip: true;
        input := TextInput {
            width: 100%;
            height: 100%;
            color: Theme.label;
            selection-background-color: Theme.material ? Theme.m3-primary.with-alpha(0.3) : Theme.accent.with-alpha(0.4);
            font-size: Theme.body + 1px;
            vertical-alignment: center;
            single-line: true;
            input-type: search;
            accessible-label: root.placeholder;
            accessible-placeholder-text: root.placeholder;
            edited => { root.edited(self.text); }
            key-pressed(e) => {
                if root.key(e) { return accept; }
                reject
            }
        }
        if input.text == "": Text {
            // (2px in: the caret at x 0 stays off the first letter)
            x: 2px;
            width: parent.width - 2px;
            height: 100%;
            text: root.placeholder;
            color: Theme.tertiary;
            font-size: Theme.body + 1px;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
    // (Tab reaches the clear button; the keys it doesn't use still reach the
    // panel's `key`: Escape, the arrows)
    clear-keys := FocusScope {
        visible: clearable && input.text != "";
        width: 28px;
        height: 28px;
        x: parent.width - self.width - 4px;
        y: (parent.height - self.height) / 2;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(e) => {
            if root.key(e) { return accept; }
            reject
        }
        clear := IconButton {
            x: 0;
            y: 0;
            icon: "\u{e4f8}";
            fill: true;
            icon-color: Theme.tertiary;
            label: "Clear search";
            clicked => {
                input.text = "";
                root.edited("");
                input.focus();
            }
        }
    }
}

// One key cap (KeyCombo.qml)
export component Keycap inherits Rectangle {
    in property <string> text;
    width: max(24px, label.preferred-width + 12px);
    height: 22px;
    border-radius: 6px;
    background: Theme.fill;
    border-width: 1px;
    border-color: Theme.separator;
    label := Text {
        text: root.text;
        color: Theme.label;
        font-size: Theme.small;
        font-weight: 500;
        accessible-role: none;
    }
}

// Key caps and what they do: "Enter Insert"
export component KeyHint inherits HorizontalLayout {
    in property <[string]> keys;
    in property <string> text;
    spacing: 4px;
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    for k in keys: Keycap { text: k; }
    Text {
        text: root.text;
        color: Theme.tertiary;
        font-size: Theme.small;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Loading: a spinning ring (Glass: the circle-notch icon; Material: its
// loading indicator, an arc that grows and shrinks as it turns)
export component Busy inherits Rectangle {
    width: Theme.material ? 40px : 24px;
    height: self.width;
    accessible-role: progress-indicator;
    accessible-label: "Loading";
    property <duration> t: animation-tick();
    property <float> turn: mod(t / 900ms, 1);
    if !Theme.material: Text {
        text: "\u{eb44}";
        font-family: "Phosphor";
        font-size: 24px;
        color: Theme.tertiary;
        transform-rotation: turn * 360deg;
        accessible-role: none;
    }
    if Theme.material: Path {
        width: 40px;
        height: 40px;
        viewbox-width: 40;
        viewbox-height: 40;
        stroke: Theme.m3-primary;
        stroke-width: 4px;
        property <float> a: mod(root.t / 1333ms, 1) * 360;
        property <float> sweep: 40 + 220 * abs(sin(mod(root.t / 2666ms, 1) * 180deg));
        transform-rotation: a * 1deg;
        MoveTo { x: 20 + 16 * cos(0deg); y: 20 + 16 * sin(0deg); }
        ArcTo { x: 20 + 16 * cos(sweep * 1deg); y: 20 + 16 * sin(sweep * 1deg); radius-x: 16; radius-y: 16; large-arc: sweep > 180; sweep: true; }
    }
}

// Material's empty states: an icon on a shape (cookie, clover, burst: the
// outline from Rust, src/surfaces/shapes.rs)
export component StateShape inherits Rectangle {
    in property <string> outline; // SVG path commands in a 0..100 box
    in property <string> icon;
    in property <color> shape-color;
    in property <color> icon-color;
    in property <length> icon-size: 28px;
    width: 64px;
    height: 64px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: outline;
        fill: shape-color;
    }
    SymIcon {
        text: icon;
        font-size: icon-size;
        color: icon-color;
    }
}

// A text button for empty and error states (PickerButton.qml): primary
// (accent) or secondary (fill); Material: a filled or tonal pill, its
// corners tightening while pressed
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    // the widest it grows (a long or translated label is elided, not run
    // past its panel or over its neighbour)
    in property <length> limit: 320px;
    // (off: greyed, no hover or press look, not pressable)
    in property <bool> enabled: true;
    callback clicked();
    opacity: enabled ? 1 : Theme.disabled-alpha;
    property <color> ink: Theme.material ? (primary ? Theme.m3-on-primary : Theme.m3-on-secondary-container) : primary ? Theme.on-accent : Theme.label;
    property <length> pad: Theme.material ? 40px : 32px;
    width: min(limit, label.preferred-width + pad);
    height: Theme.material ? 40px : 36px;
    border-radius: Theme.material ? (touch.pressed ? 12px : self.height / 2) : Theme.radius-control;
    // (PickerButton.qml: Material's corners on the fast spatial spring; a
    // press swells it (Theme.motion.pressGrow: ~6%, at most 10 px) on the
    // press spring, Glass presses in to 97%)
    animate border-radius { duration: Theme.move-spatial; easing: spring(0.4); }
    transform-scale: touch.pressed ? (Theme.material ? (Theme.press-bounce ? 1 + min(0.06, 10px / max(1px, self.width)) : 1) : 0.97) : 1;
    animate transform-scale { duration: Theme.motion(Theme.material ? 290ms : 100ms); easing: Theme.material ? spring(0.57) : ease-out; }
    background: Theme.material ? (primary ? Theme.m3-primary : Theme.m3-secondary-container).mix(ink, touch.pressed ? 0.9 : touch.has-hover ? 0.92 : 1)
        : primary ? (touch.pressed ? Theme.accent.darker(0.2) : touch.has-hover ? Theme.accent.darker(0.1) : Theme.accent) : touch.pressed ? Theme.fill-pressed : touch.has-hover ? Theme.fill-hover : Theme.fill;
    animate background { duration: Theme.hover; }
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { clicked(); } }
    // (Tab reaches it, Enter or Space presses it)
    forward-focus: keys;
    keys := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        property <bool> keyed;
        focus-gained(r) => { self.keyed = r == FocusReason.tab-navigation; }
        key-pressed(e) => {
            if !e.repeat && (e.text == " " || e.text == Key.Return) {
                self.keyed = true;
                root.clicked();
                return accept;
            }
            reject
        }
    }
    label := Text {
        width: max(0px, parent.width - pad);
        text: root.text;
        color: ink;
        font-size: Theme.body;
        font-weight: 500;
        horizontal-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            keys.keyed = false;
            root.clicked();
        }
    }
    FocusRing { shown: keys.has-focus && keys.keyed; radius: root.border-radius; }
}

// The one scroll indicator (ScrollIndicator.qml): a thin bar over a list's
// right edge while it scrolls, gone 0.9 s after it stops. Lay it over the
// Flickable (same y and height, at its right edge) and hand it the
// Flickable's numbers; it shows only when there is more than fits.
// `draggable` (a list with a gutter on its right, so the 12 px track takes
// no row's clicks): it also shows while the pointer is on it, the thumb
// drags and a click on the track jumps; `scroll-to(y)` hands back the
// Flickable's new content-y (set `list.content-y = y`).
export component ScrollIndicator inherits Rectangle {
    in property <length> content-y;
    in property <length> content-height;
    in property <length> view-height;
    in property <bool> draggable;
    callback scroll-to(length);
    width: 12px;
    visible: content-height > view-height + 1px;
    property <bool> moving;
    property <bool> moved;
    property <length> span: max(1px, content-height - view-height);
    property <length> th: max(28px, view-height * view-height / max(1px, content-height));
    property <length> ty: (view-height - th) * max(0, min(1, -content-y / span));
    property <bool> held: draggable && (track.has-hover || thumb.pressed);
    changed content-y => {
        moving = true;
        moved = true;
    }
    Timer {
        interval: 900ms;
        running: root.moving;
        triggered => {
            if root.moved { root.moved = false; } else { root.moving = false; }
        }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: root.held ? 8px : 6px;
        animate width { duration: Theme.move-fast; }
        border-radius: self.width / 2;
        height: root.th;
        y: root.ty;
        background: (Theme.dark ? #ffffff : #000000).with-alpha(thumb.pressed ? 0.5 : 0.32);
        opacity: root.moving || root.held ? 1 : 0;
        animate opacity { duration: root.moving || root.held ? Theme.hover : 400ms; easing: ease-out; }
    }
    track := TouchArea {
        enabled: root.draggable;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && (self.mouse-y < root.ty || self.mouse-y > root.ty + root.th) {
                root.scroll-to(-max(0px, min(root.span, (self.mouse-y - root.th / 2) / max(1px, self.height - root.th) * root.span)));
            }
        }
        thumb := TouchArea {
            y: root.ty;
            height: root.th;
            enabled: root.draggable;
            property <length> grab;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    self.grab = self.mouse-y;
                }
            }
            moved => {
                if self.pressed {
                    root.scroll-to(-max(0px, min(root.span, (root.ty + self.mouse-y - self.grab) / max(1px, root.height - root.th) * root.span)));
                }
            }
        }
    }
}

// A spinner (Spinner.qml) at any size: Glass the circle-notch turning,
// Material its loading arc that grows and shrinks as it turns
export component Spinner inherits Rectangle {
    in property <length> size: 16px;
    in property <color> ink: Theme.material ? Theme.m3-primary : Theme.secondary;
    in property <string> label: "Loading";
    width: size;
    height: size;
    accessible-role: progress-indicator;
    accessible-label: label;
    property <duration> t: animation-tick();
    if !Theme.material: Text {
        width: 100%;
        height: 100%;
        text: "\u{eb44}";
        font-family: "Phosphor-Bold";
        font-size: root.size;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        transform-rotation: mod(root.t / 800ms, 1) * 360deg;
        accessible-role: none;
    }
    if Theme.material: Path {
        width: root.size;
        height: root.size;
        viewbox-width: 40;
        viewbox-height: 40;
        stroke: root.ink;
        stroke-width: max(2px, root.size / 10);
        property <float> a: mod(root.t / 1333ms, 1) * 360;
        property <float> sweep: 40 + 220 * abs(sin(mod(root.t / 2666ms, 1) * 180deg));
        transform-rotation: a * 1deg;
        MoveTo { x: 20 + 16 * cos(0deg); y: 20 + 16 * sin(0deg); }
        ArcTo { x: 20 + 16 * cos(sweep * 1deg); y: 20 + 16 * sin(sweep * 1deg); radius-x: 16; radius-y: 16; large-arc: sweep > 180; sweep: true; }
    }
}

// A pill button (SettingsButton.qml, Dialog.qml's buttons) with every
// state: hover, pressed, keyboard focus, off. kind: 0 tonal (Glass the fill;
// Material secondary container), 1 filled (the accent; Material primary),
// 2 danger (red text, a red tint under the pointer), 3 text (no fill at
// rest; Material primary text). An optional icon before the text. Glass
// presses in to 97%; Material's corners tighten while pressed and it swells
// (press bounce).
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <int> kind;
    in property <bool> enabled: true;
    in property <string> label; // what a screen reader says ("": the text)
    // the widest it grows (a long or translated label is elided)
    in property <length> limit: 320px;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    property <bool> m3: Theme.material;
    property <bool> down: touch.pressed;
    property <bool> over: touch.has-hover;
    property <color> ink: kind == 1 ? (m3 ? Theme.m3-on-primary : Theme.on-accent)
        : kind == 2 ? (m3 ? Theme.m3-error : Theme.danger)
        : kind == 3 ? (m3 ? Theme.m3-primary : Theme.accent-ink)
        : m3 ? Theme.m3-on-secondary-container : Theme.label;
    property <length> pad: m3 ? (kind >= 2 ? 24px : 48px) : 24px;
    width: min(limit, row.preferred-width + pad);
    height: m3 ? 40px : 32px;
    opacity: enabled ? 1 : Theme.disabled-alpha;
    border-radius: m3 ? (down ? 12px : self.height / 2) : Theme.radius-control;
    animate border-radius { duration: Theme.move-spatial; easing: spring(0.4); }
    transform-scale: down ? (m3 ? (Theme.press-bounce ? 1 + min(0.06, 10px / max(1px, self.width)) : 1) : 0.97) : 1;
    animate transform-scale { duration: Theme.motion(m3 ? 290ms : 100ms); easing: m3 ? spring(0.57) : ease-out; }
    background: kind == 1 ? (m3 ? Theme.m3-primary.mix(ink, down ? 0.9 : over ? 0.92 : 1) : down ? Theme.accent.darker(0.2) : over ? Theme.accent.darker(0.1) : Theme.accent)
        : kind == 0 ? (m3 ? Theme.m3-secondary-container.mix(ink, down ? 0.9 : over ? 0.92 : 1) : down ? Theme.fill-pressed : over ? Theme.fill-hover : Theme.fill)
        : kind == 2 && !m3 ? Theme.danger.with-alpha(down ? 0.22 : over ? 0.15 : 0)
        : m3 ? ink.with-alpha(down ? 0.1 : over ? 0.08 : 0)
        : down ? Theme.fill-pressed : over ? Theme.fill : transparent;
    animate background { duration: Theme.hover; }
    accessible-role: button;
    accessible-label: label != "" ? label : text;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { clicked(); } }
    forward-focus: keys;
    keys := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if !e.repeat && (e.text == " " || e.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    FocusRing { shown: keys.has-focus; radius: root.border-radius; }
    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if root.icon != "": SymIcon {
            text: root.icon;
            font-size: 16px;
            color: root.ink;
        }
        Text {
            text: root.text;
            color: root.ink;
            font-size: m3 ? 14px : Theme.body;
            font-weight: kind == 1 && !m3 ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A switch (Switch.qml): Glass the accent when on, a white knob (hover and
// press darken the track); Material primary with the thumb that grows on
// and while pressed, a state layer round it, a tick on it when on. Space or
// Enter toggles it from the keyboard.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled();
    property <bool> m3: Theme.material;
    width: m3 ? 52px : 38px;
    height: m3 ? 32px : 22px;
    opacity: enabled ? 1 : Theme.disabled-alpha;
    border-radius: self.height / 2;
    background: m3 ? (checked ? Theme.m3-primary : Theme.m3-surface-container-highest.with-alpha(Theme.control-alpha))
        : checked ? (t.pressed ? Theme.accent.darker(0.15) : t.has-hover ? Theme.accent.darker(0.07) : Theme.accent)
        : t.pressed ? Theme.fill-pressed : t.has-hover ? Theme.fill-hover : Theme.toggle-off;
    animate background { duration: Theme.hover; }
    border-width: m3 && !checked ? 2px : 0;
    border-color: Theme.m3-outline;
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { toggled(); } }
    forward-focus: keys;
    keys := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if !e.repeat && (e.text == " " || e.text == Key.Return) {
                root.toggled();
                return accept;
            }
            reject
        }
    }
    FocusRing { shown: keys.has-focus; radius: root.height / 2; }
    // Glass: the knob (a little wider while pressed)
    if !m3: Rectangle {
        width: parent.height - 4px + (t.pressed ? 4px : 0);
        height: parent.height - 4px;
        y: 2px;
        x: checked ? parent.width - self.width - 2px : 2px;
        border-radius: self.height / 2;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000033;
        animate x, width { duration: Theme.move-standard; easing: Ease.standard; }
    }
    // Material: the state layer and the thumb
    property <length> size: t.pressed ? 28px : checked ? 24px : 16px;
    property <length> cx: checked ? self.width - 16px : 16px;
    animate size, cx { duration: Theme.motion(300ms); easing: spring(0.54); }
    if m3 && (t.has-hover || t.pressed): Rectangle {
        x: root.cx - 20px;
        y: (parent.height - 40px) / 2;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: (checked ? Theme.m3-primary : Theme.m3-on-surface).with-alpha(t.pressed ? 0.1 : 0.08);
    }
    if m3: Rectangle {
        x: root.cx - root.size / 2;
        y: (parent.height - root.size) / 2;
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: checked ? Theme.m3-on-primary : t.has-hover || t.pressed ? Theme.m3-on-surface-variant : Theme.m3-outline;
        animate background { duration: Theme.hover; }
        if checked: SymIcon {
            text: "\u{e182}"; // check
            bold: true;
            font-size: 12px;
            color: Theme.m3-on-primary-container;
        }
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Segmented.qml: Glass, a track with a light pill sliding to the chosen one
// (the others lighten under the pointer); Material, a connected button
// group (2 px apart, round ends, 8 px inside; the chosen one fills and turns
// round). Each segment fits its label plus 24 px; the room to spare is
// shared equally (too little shrinks them alike). The arrows step it, Home
// and End take the first and the last.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <string> label;
    in property <bool> enabled: true;
    callback selected(int);
    property <bool> m3: Theme.material;
    property <length> gap: m3 ? 2px : 0;
    // (Glass: where the chosen segment is, for the sliding pill)
    property <length> pill-x;
    property <length> pill-w;
    height: m3 ? 36px : 30px;
    border-radius: self.height / 2;
    background: m3 ? transparent : Theme.toggle-off;
    opacity: enabled ? 1 : Theme.disabled-alpha;
    accessible-role: tab-list;
    accessible-label: label;
    accessible-description: current >= 0 && current < options.length ? options[current] : "";
    accessible-enabled: enabled;
    forward-focus: keys;
    keys := FocusScope {
        // (a click goes to what's under it: keys only)
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.LeftArrow || e.text == Key.UpArrow {
                if current > 0 { selected(current - 1); }
                return accept;
            }
            if e.text == Key.RightArrow || e.text == Key.DownArrow {
                if current < options.length - 1 { selected(current + 1); }
                return accept;
            }
            if e.text == Key.Home { selected(0); return accept; }
            if e.text == Key.End { selected(options.length - 1); return accept; }
            reject
        }
    }
    FocusRing { shown: keys.has-focus; radius: root.height / 2; }
    // Glass: the selection pill, sliding to the chosen one
    if !m3: Rectangle {
        x: root.pill-x;
        y: 2px;
        width: root.pill-w;
        height: root.height - 4px;
        border-radius: self.height / 2;
        background: Theme.dark ? #ffffff33 : #ffffff;
        drop-shadow-blur: Theme.dark ? 0 : 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #0000001f;
        animate x, width { duration: Theme.move-standard; easing: Ease.standard; }
    }
    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: gap;
        for o[i] in options: Rectangle {
            property <bool> chosen: i == current;
            property <length> full: self.height / 2;
            property <length> inner: chosen ? full : touch.pressed ? 4px : 8px;
            min-width: 0;
            preferred-width: measure.preferred-width + 24px;
            horizontal-stretch: 1;
            height: parent.height;
            init => { if chosen { root.pill-x = self.x; root.pill-w = self.width; } }
            changed chosen => { if chosen { root.pill-x = self.x; root.pill-w = self.width; } }
            changed x => { if chosen { root.pill-x = self.x; root.pill-w = self.width; } }
            changed width => { if chosen { root.pill-x = self.x; root.pill-w = self.width; } }
            measure := Text {
                visible: false;
                text: o;
                font-size: m3 ? Theme.body : Theme.small;
                font-weight: m3 ? 500 : 600;
            }
            // Glass: a light layer under the pointer on the others
            if !m3 && !chosen: Rectangle {
                y: 2px;
                height: parent.height - 4px;
                border-radius: self.height / 2;
                background: touch.pressed ? Theme.fill-pressed : touch.has-hover ? Theme.fill : transparent;
                animate background { duration: Theme.hover; }
            }
            border-top-left-radius: !m3 ? 0 : i == 0 ? full : inner;
            border-bottom-left-radius: self.border-top-left-radius;
            border-top-right-radius: !m3 ? 0 : i == options.length - 1 ? full : inner;
            border-bottom-right-radius: self.border-top-right-radius;
            animate border-top-left-radius, border-top-right-radius { duration: Theme.motion(200ms); easing: spring(0.6); }
            background: !m3 ? transparent : chosen ? Theme.m3-primary.mix(Theme.m3-on-primary, touch.pressed ? 0.9 : touch.has-hover ? 0.92 : 1)
                : Theme.m3-surface-container-highest.with-alpha(Theme.control-alpha).mix(Theme.m3-on-surface-variant, touch.pressed ? 0.9 : touch.has-hover ? 0.92 : 1);
            animate background { duration: Theme.hover; }
            accessible-role: tab;
            accessible-label: o;
            accessible-checked: chosen;
            accessible-action-default => { if root.enabled { selected(i); } }
            Text {
                text: o;
                color: m3 ? (chosen ? Theme.m3-on-primary : Theme.m3-on-surface-variant) : chosen ? Theme.label : Theme.secondary;
                font-size: m3 ? Theme.body : Theme.small;
                font-weight: m3 ? 500 : 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
        }
    }
}

// A text field (TextField.qml): Glass a fill outlined in the separator, in
// the accent while typing; Material FilledField's pill, outlined in primary
// while typing. `accepted` on Enter, `edited` as it changes, `left` as the
// focus goes elsewhere (keep what was typed).
export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <string> label; // what a screen reader says ("": the placeholder)
    in property <bool> read-only;
    in property <bool> enabled: true;
    in property <bool> autofocus;
    in property <InputType> input-type: InputType.text;
    out property <bool> focused: input.has-focus;
    callback accepted(string);
    callback edited(string);
    callback left(string);
    public function focus-input() {
        input.focus();
    }
    public function select-all() {
        input.select-all();
    }
    public function set-text(t: string) {
        input.text = t;
    }
    init => {
        if root.autofocus {
            input.focus();
        }
    }
    property <bool> m3: Theme.material;
    property <length> inset: m3 ? 16px : 10px;
    property <bool> over: hover.has-hover && !input.has-focus && enabled && !read-only;
    height: m3 ? 40px : 32px;
    border-radius: m3 ? min(self.height / 2, 28px) : Theme.radius-control - 2px;
    // (under the pointer: Material's state layer, Glass's hover fill)
    background: m3 ? Theme.m3-surface-container-highest.with-alpha(Theme.control-alpha).mix(Theme.m3-on-surface, over ? 0.92 : 1) : over ? Theme.fill-hover : Theme.fill;
    animate background { duration: Theme.hover; }
    border-width: m3 ? (input.has-focus ? 2px : 0) : 1px;
    border-color: m3 ? Theme.m3-primary : input.has-focus ? Theme.accent : Theme.separator;
    opacity: !enabled ? Theme.disabled-alpha : read-only ? 0.7 : 1;
    clip: true;
    // (a click anywhere on it, the padding too, puts the caret in)
    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    input := TextInput {
        x: root.inset;
        width: parent.width - 2 * root.inset;
        height: parent.height;
        color: Theme.label;
        font-size: Theme.body;
        vertical-alignment: center;
        single-line: true;
        enabled: root.enabled;
        read-only: root.read-only;
        input-type: root.input-type;
        selection-background-color: m3 ? Theme.m3-primary.with-alpha(0.3) : Theme.accent.with-alpha(0.4);
        accessible-label: root.label != "" ? root.label : root.placeholder;
        accessible-placeholder-text: root.placeholder;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
        changed has-focus => {
            if !self.has-focus {
                root.left(self.text);
            }
        }
    }
    if input.text == "": Text {
        x: input.x + 2px;
        width: input.width - 2px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.tertiary;
        font-size: Theme.body;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

// A context or dropdown menu's row (ContextMenu.qml): a heading, a
// separator, or an item that lights in the highlight while `hot` (under the
// pointer or the arrows; `hovered` says the pointer came onto it); danger
// items read red (Glass: a red highlight). `armed`: a danger item waiting
// for a second click, filled red with its `confirm` text ("Quit?").
// The menu around it is its own.
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> header;
    in property <bool> separator;
    in property <bool> enabled: true;
    in property <bool> danger;
    in property <bool> hot;
    in property <bool> armed;
    in property <string> confirm;
    callback activate();
    callback hovered();
    property <bool> item: !header && !separator;
    property <bool> lit: hot && enabled && item;
    property <string> shown-text: armed && item ? confirm : text;
    height: separator ? 11px : header ? 26px : 28px;
    accessible-role: list-item;
    accessible-label: shown-text;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled && item { activate(); } }
    if separator: Rectangle {
        x: 9px;
        width: parent.width - 18px;
        height: 1px;
        background: Theme.separator;
    }
    if header: Text {
        x: 12px;
        y: parent.height - self.height - 4px;
        text: root.text;
        color: Theme.material ? Theme.m3-primary : Theme.secondary;
        font-size: Theme.small;
        font-weight: 500;
        accessible-role: none;
    }
    if item: Rectangle {
        border-radius: Theme.radius-menu-row;
        background: armed ? Theme.danger : lit ? (danger && !Theme.material ? Theme.danger : Theme.highlight) : rt.pressed ? Theme.fill-pressed : transparent;
        Text {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: root.shown-text;
            font-size: Theme.body;
            font-weight: armed ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            // (on-highlight: dark text on a light accent, both looks)
            color: armed ? (Theme.material ? Theme.m3-on-error : #ffffff) : lit && !(Theme.material && danger) ? (danger ? #ffffff : Theme.on-highlight) : !enabled ? Theme.tertiary : danger ? Theme.danger : Theme.label;
            accessible-role: none;
        }
    }
    rt := TouchArea {
        enabled: root.enabled && root.item;
        changed has-hover => {
            if self.has-hover { root.hovered(); }
        }
        clicked => { root.activate(); }
    }
}
