// The on-screen keyboard's keys (compare shell/modules/osk/Keyboard.qml):
// five rows of caps, shared by the keyboard's own window (surfaces/osk) and
// the lock, which draws them on its own session-lock surface (#763: nothing
// else may draw over a locked screen). Rust fills the rows (surfaces/osk's
// keys.rs) and acts on a press.
// Glass: keys shrinking a little while pressed. Material, as Gboard:
// letters on the highest container, the other keys tonal, Return in primary
// container, a latched modifier filled primary; a pressed key rounds into a
// pill. A key types as it goes down and, held, again after 400 ms and then
// every 40 ms, as a hardware keyboard repeats (#1051); modifiers only latch.

import { Theme } from "theme.slint";

export struct OskKey {
    text: string,
    name: string, // what a screen reader says
    units: float, // its width in key units
    modifier: bool, // Shift, Ctrl, Alt, Super, Caps
    wide: bool, // a modifier or wider than one unit (the tonal keys)
    action: bool, // Return
    latched: bool,
    long: bool, // a word on it ("Tab"): the smaller size
}

export struct OskRow {
    keys: [OskKey],
}

component Cap inherits Rectangle {
    in property <OskKey> key;
    in property <length> unit;
    callback pressed();
    callback repeat();
    // (held past the first delay: the quick repeats)
    property <bool> repeating;
    property <color> m-base: key.latched ? Theme.m3-primary : key.action ? Theme.m3-primary-container : key.wide ? Theme.m3-secondary-container : Theme.m3-surface-container-highest;
    property <color> m-ink: key.latched ? Theme.m3-on-primary : key.action ? Theme.m3-on-primary-container : key.wide ? Theme.m3-on-secondary-container : Theme.m3-on-surface;
    width: unit * key.units - 6px;
    height: unit - 6px;
    border-radius: Theme.material ? (touch.pressed || key.latched ? self.height / 2 : 12px) : 10px;
    animate border-radius { duration: Theme.move-spatial; easing: spring(0.4); } // (springFast)
    background: Theme.material ? m-base.mix(m-ink, touch.pressed ? 0.9 : touch.has-hover ? 0.92 : 1)
        : key.latched ? Theme.accent : touch.pressed ? Theme.fill-pressed : touch.has-hover ? Theme.fill-hover : key.wide ? Theme.toggle-off : Theme.fill;
    // (Glass shrinks while pressed; Material swells a little, on its spring)
    // (Material: ElasticControl ~6 %, ≤ 10 px, on springPress; Glass: 95 % over `press`, linear)
    transform-scale: touch.pressed ? (Theme.material ? 1 + min(0.06, 10px / max(1px, max(self.width, self.height))) : 0.95) : 1;
    animate transform-scale { duration: Theme.motion(Theme.material ? 290ms : 100ms); easing: Theme.material ? spring(0.57) : linear; }
    accessible-role: button;
    accessible-label: key.name;
    accessible-checkable: key.modifier;
    accessible-checked: key.latched;
    accessible-action-default => { pressed(); }
    Text {
        text: key.text;
        color: Theme.material ? m-ink : key.latched ? Theme.on-accent : Theme.label;
        font-size: key.long ? (Theme.material ? 14px : Theme.small) : (Theme.material ? 20px : Theme.title);
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.repeating = false;
                root.pressed();
            }
        }
    }
    Timer {
        interval: root.repeating ? 40ms : 400ms;
        running: touch.pressed && !root.key.modifier;
        triggered => {
            root.repeating = true;
            root.repeat();
        }
    }
}

// The rows, centred in whatever holds them: (row, column) of the key pressed
export component KeyGrid inherits VerticalLayout {
    in property <[OskRow]> rows;
    in property <length> unit: 58px;
    callback pressed(int, int);
    callback repeat(int, int);
    alignment: center;
    spacing: 6px;
    for orow[r] in root.rows: HorizontalLayout {
        alignment: center;
        spacing: 6px;
        for k[c] in orow.keys: Cap {
            key: k;
            unit: root.unit;
            pressed => { root.pressed(r, c); }
            repeat => { root.repeat(r, c); }
        }
    }
}
