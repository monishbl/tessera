// Tessera's interface in Rust: what every surface shares (the look's tokens,
// the icon font, small components). Rust fills `Theme` from config.json for
// both looks (src/theme.rs), as shell/common/Theme.qml does for QML.

// ── Tokens ──────────────────────────────────────────────────────────────────
export global Theme {
    in property <bool> material: false;
    in property <bool> dark: true;
    // the glass plugin draws the glass under glass shapes (with their tint and rim)
    in property <bool> plugin: false;
    in property <string> font: "Inter";
    in property <length> body: 13px;
    // Bar
    in property <color> bar-tint: #1a1a1e60; // Glass: the strip over the plugin's glass
    in property <color> fg: #ffffffeb;
    in property <color> pill: transparent; // Material: the groups' tonal pills
    in property <color> dot: #ffffff; // spaces: dots
    in property <color> dot-active: #ffffff47; // spaces: the sliding capsule (Glass) / pill (Material)
    // Menu
    in property <color> menu-bg: #26262ae0;
    in property <color> menu-fg: #ffffffeb;
    in property <color> menu-dim: #ffffff99;
    in property <color> menu-hover: #0a84ff;
    in property <color> menu-hover-fg: #ffffff;
    in property <color> separator: #ffffff1f;
    in property <color> field-bg: #ffffff14;
    in property <color> field-focus: #0a84ff;
    in property <length> menu-radius: 12px;
    in property <length> item-radius: 6px;

    // ── The shell's general tokens (shell/common/Theme.qml: color, font,
    // radius), filled by theme.rs for both looks at the contrast Settings asks
    // Text and lines
    in property <color> label: #ffffffeb;
    in property <color> secondary: #ffffff94;
    in property <color> tertiary: #ffffff57;
    in property <color> outline: #ffffff6b;
    // Fills: buttons, tiles, tracks; platter: a grouped block
    in property <color> fill: #ffffff1a;
    in property <color> fill-hover: #ffffff29;
    in property <color> fill-pressed: #ffffff38;
    in property <color> platter: #ffffff12;
    in property <color> toggle-off: #ffffff24;
    // Accent and selection
    in property <color> accent: #0a84ff;
    in property <color> on-accent: #ffffff;
    in property <color> highlight: #0a84ff;
    in property <color> on-highlight: #ffffff;
    in property <color> selection: #0a84ff;
    in property <color> on-selection: #ffffff;
    // Status
    in property <color> danger: #ff453a;
    in property <color> success: #30d158;
    in property <color> warning: #ff9f0a;
    // A panel's own colour under its content (Glass: a tint over the
    // plugin's glass; Material: its surface container)
    in property <color> panel: #1e1e2273;
    // Material roles (Material only; the Glass values are fallbacks)
    in property <color> m3-primary: #0a84ff;
    in property <color> m3-on-primary: #ffffff;
    in property <color> m3-primary-container: #0a84ff;
    in property <color> m3-on-primary-container: #ffffff;
    in property <color> m3-secondary: #ffffffa0;
    in property <color> m3-secondary-container: #ffffff24;
    in property <color> m3-on-secondary-container: #ffffff;
    in property <color> m3-tertiary: #0a84ff;
    in property <color> m3-on-tertiary: #ffffff; // (Today: the weather icon on its shape)
    in property <color> m3-surface: #1c1c1e;
    in property <color> m3-surface-container-low: #1c1c1e;
    in property <color> m3-surface-container: #232327;
    in property <color> m3-surface-container-high: #2c2c31;
    in property <color> m3-surface-container-highest: #333338;
    in property <color> m3-on-surface: #ffffff;
    in property <color> m3-on-surface-variant: #ffffffa0;
    in property <color> m3-outline: #ffffff6b;
    in property <color> m3-outline-variant: #ffffff24;
    in property <color> m3-error: #ff453a;
    in property <color> m3-on-error: #ffffff;
    in property <color> m3-error-container: #ff453a40;
    in property <color> m3-on-error-container: #ffffff;
    in property <color> m3-tertiary-container: #0a84ff;
    in property <color> m3-on-tertiary-container: #ffffff;
    in property <color> m3-inverse-surface: #e6e1e5;
    in property <color> m3-inverse-on-surface: #313033;
    // Status colours that aren't the accent (Theme.accents: unread is always
    // the system blue; Low Power's battery is yellow)
    in property <color> blue: #0a84ff;
    in property <color> yellow: #ffd60a;
    // Radius of an item (menu rows, bar items) and of iOS tiles (the island's open corners)
    in property <length> radius-item: 6px;
    in property <length> radius-tile: 36px;
    // Motion: Theme.motion's durations
    in property <duration> hover: 150ms;
    in property <duration> popover: 220ms;
    // (Theme.motion.panel: Dialog.qml and the launchpad close in 0.6 of it)
    in property <duration> motion-panel: 320ms;
    // Key hints, as Settings → Appearance → Shortcut symbols writes them
    // (tessera_core::keynames::combo: "Ctrl+S" or "⌃S"; audit #1047)
    in property <string> key-save: "Ctrl+S";
    in property <string> key-save-copy: "Ctrl+Shift+S";
    in property <string> key-copy: "Ctrl+C";
    in property <string> key-undo: "Ctrl+Z";
    in property <string> key-redo: "Ctrl+Shift+Z";
    in property <string> key-esc: "Esc";
    in property <string> key-del: "Del";
    in property <string> key-enter: "Enter";
    in property <string> key-ctrl-enter: "Ctrl+Enter";
    in property <color> m3-primary-fixed: #eaddff;
    in property <color> m3-primary-fixed-dim: #d0bcff;
    in property <color> m3-shadow: #000000;
    in property <color> m3-scrim: #000000;
    // Glass's opaque surface (Theme.glass.solid: small popups over a panel)
    in property <color> glass-solid: #26262a;
    // Material's see-through panels (Theme.qml's blur / panelAlpha: Settings'
    // materialTransparency; Theme.veil(c) is c.with-alpha(panel-alpha))
    in property <bool> blur: false;
    in property <float> panel-alpha: 1;
    in property <color> m3-inverse-primary: #0a84ff;
    // Accent text and small glyphs on the window background (≥ 4.5:1),
    // selected rows' soft tint, Markdown's code boxes (Theme.accentInk,
    // accentTint, codeFill), and the code font
    in property <color> accent-ink: #409cff;
    in property <color> accent-tint: #0a84ff42;
    in property <color> code-fill: #ffffff14;
    in property <string> mono: "JetBrains Mono";

    // (Theme.qml's controlAlpha: Material's container roles, see-through as far as Transparency says)
    in property <float> control-alpha: 1;
    // Type: sizes (Theme.font)
    in property <length> caption: 11px;
    in property <length> small: 12px;
    in property <length> title: 15px;
    in property <length> large: 20px;
    in property <length> display: 24px;
    // Radii (Theme.radius)
    in property <length> radius-control: 10px;
    in property <length> radius-popover: 18px;
    in property <length> radius-module: 20px;
    in property <length> radius-panel: 26px;
    // Motion: the shell's spring (Theme.motion; 0..1, Slint's spring() damping)
    in property <float> spring: 0.32;
    // Theme.motion.expressive (appearance.motion; the Material look always),
    // .snappy (a Glass choice), .pressBounce (Material's press swell, off with
    // Reduce motion): a surface picks its springs and durations from these
    in property <bool> expressive: false;
    in property <bool> snappy: false;
    in property <bool> press-bounce: false;
    // Reduce motion, or battery saver (saver.rs): what moves on its own
    // (wavy progress, loops) holds still
    in property <bool> still: false;

    // ── Shared tokens by role (one place for every surface; derived from the
    // ones above, so theme.rs fills nothing new). A surface uses these, not
    // literals; a literal that stays is a deliberate exception, commented.

    // Reduce motion (appearance.reduceMotion, or battery saver: saver.rs
    // turns it on). The one switch every motion token below reads: what
    // moves (position, size, scale, a spring) jumps; colour and opacity
    // changes stay, as short crossfades.
    out property <bool> reduce-motion: still;

    // Radii (Glass / Material)
    // rows, bar items, key caps: 6 / 8
    out property <length> radius-small: radius-item;
    // cards and widgets: 20 / 24
    out property <length> radius-card: radius-module;
    // dropdown and context menus (the bar's, a window's, the dock's, the
    // desktop's): 14 / 16; their rows 8
    out property <length> radius-menu: material ? 16px : 14px;
    out property <length> radius-menu-row: 8px;
    // the menu bar's popovers (Wi-Fi, Bluetooth, Sound, Battery, ...) and
    // big panels: 26 / 28 (Theme.radius-panel; radius-control + their 16 px pad)
    out property <length> radius-popover-panel: radius-panel;

    // The menu bar's popovers: one content width, one padding, one title
    // (Glass: 15 semibold; Material: title-large, 22 regular)
    out property <length> popover-width: 300px;
    out property <length> popover-pad: 16px;
    out property <length> menu-title: material ? 22px : title;
    out property <int> menu-title-weight: material ? 400 : 600;

    // Motion: durations by role (already 0.85 for Snappy), 0 with Reduce motion.
    // hover (above) is the colour/state fade and stays with Reduce motion.
    // fast: small moves (a knob, a thumb, a press)
    out property <duration> move-fast: reduce-motion ? 0ms : hover;
    // standard: a popover or menu opening
    out property <duration> move-standard: reduce-motion ? 0ms : popover;
    // emphasized: a panel or a big surface opening
    out property <duration> move-emphasized: reduce-motion ? 0ms : motion-panel;
    // close: a popover or menu leaving (0.7 of its open); a panel (0.6)
    out property <duration> move-close: reduce-motion ? 0ms : popover * 0.7;
    out property <duration> move-panel-close: reduce-motion ? 0ms : motion-panel * 0.6;
    // Material's fast spatial spring (springFast: 222 ms, spring(0.4))
    out property <duration> move-spatial: reduce-motion ? 0ms : 222ms;
    // Any other movement's duration (a deliberate exception, or a
    // conditional one): 0 with Reduce motion. A spring with no duration
    // does not run, so this also turns springs off.
    public pure function motion(d: duration) -> duration {
        return reduce-motion ? 0ms : d;
    }
}

// Easing curves by role. (Not in Theme: Slint can't hand an easing to Rust,
// and Theme is every surface's public global. A spring can't be a token:
// spring() takes a literal; Theme.motion() turns springs off.)
export global Ease {
    // Material 3's standard and emphasized enter / exit
    out property <easing> standard: cubic-bezier(0.2, 0, 0, 1);
    out property <easing> decelerate: cubic-bezier(0.05, 0.7, 0.1, 1);
    out property <easing> accelerate: cubic-bezier(0.3, 0, 0.8, 0.15);
    // Glass's: the QML's OutCubic (in) and InCubic (out)
    out property <easing> out-cubic: cubic-bezier(0.3333, 1, 0.6667, 1);
    out property <easing> in-cubic: cubic-bezier(0.3333, 0, 0.6667, 0);
}

// Phosphor glyphs used here (shell/common/phosphor.js)
export global Icons {
    out property <string> info: "\u{e2ce}";
    out property <string> gear: "\u{e270}";
    out property <string> lock: "\u{e2fa}";
    out property <string> moon: "\u{e58e}";
    out property <string> search: "\u{e30c}";
}

// (a wrapper, not `inherits Text`: an inherited Text keeps its implicit
// accessible text role even with `accessible-role: none`, so screen readers
// read the private-use glyph)
export component Icon {
    in property <string> text;
    in property <color> color;
    in property <length> font-size: 15px;
    in property <bool> fill: false;
    in property <bool> bold: false;
    preferred-width: t.preferred-width;
    preferred-height: t.preferred-height;
    t := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: root.color;
        font-size: root.font-size;
        font-family: fill ? "Phosphor-Fill" : bold ? "Phosphor-Bold" : "Phosphor";
        vertical-alignment: center;
        horizontal-alignment: center;
        accessible-role: none;
    }
}

// One bar entry: icon and/or label, a rounded highlight on hover and while
// its menu is open (MenuBarItem.qml)
export component BarItem inherits Rectangle {
    in property <string> icon;
    in property <bool> icon-fill;
    in property <string> text;
    in property <bool> bold;
    in property <bool> active;
    in property <string> label; // what a screen reader says
    callback clicked();
    height: 24px;
    width: row.preferred-width + 18px;
    border-radius: Theme.material ? self.height / 2 : Theme.radius-small;
    background: Theme.fg.with-alpha(active ? (Theme.material ? 0.16 : 0.22) : touch.pressed ? (Theme.material ? 0.1 : 0.2) : touch.has-hover ? (Theme.material ? 0.08 : 0.12) : 0);
    animate background { duration: Theme.hover; }
    accessible-role: button;
    accessible-label: label != "" ? label : text;
    accessible-action-default => { clicked(); }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if icon != "": Icon {
            text: icon;
            fill: icon-fill;
            color: Theme.fg;
            font-size: 16px;
        }
        if text != "": Text {
            text: root.text;
            color: Theme.fg;
            font-family: Theme.font;
            font-size: Theme.material ? 14px : Theme.body;
            font-weight: bold ? (Theme.material ? 600 : 700) : 500;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

