// What sits with a password field on the lock, the login screen and the
// admin password dialog (#761, #763): the line saying Caps Lock is on (and
// the keyboard layout's name when several are set up), and the on-screen
// keyboard's button. Rust fills them: tessera_core::keystate (Caps Lock,
// the layout), tessera_core::settings::OskButton (whether the button shows).

import { Theme, Icon } from "theme.slint";
import { SymIcon } from "symbols.slint";

// "⇪ Caps Lock is on · English (US)": Caps Lock in `warn` with its glyph,
// the layout plain in `ink`. Nothing to say: nothing drawn (wrap it in an
// `if caps || layout != ""` where its height matters)
export component CapsHint inherits HorizontalLayout {
    in property <bool> caps;
    in property <string> layout;
    in property <color> ink: Theme.secondary;
    in property <color> warn: ink;
    in property <length> font-size: 12px;
    in property <int> font-weight: 500;
    alignment: center;
    spacing: 5px;
    accessible-role: text;
    accessible-label: (caps ? "Caps Lock is on" : "") + (caps && layout != "" ? ", " : "") + (layout != "" ? "keyboard layout " + layout : "");
    if caps: Icon {
        text: "\u{e522}"; // arrow-fat-line-up
        fill: true;
        font-size: root.font-size;
        color: root.warn;
    }
    if caps: Text {
        text: "Caps Lock is on";
        color: root.warn;
        font-size: root.font-size;
        font-weight: root.font-weight + 100;
        vertical-alignment: center;
        accessible-role: none;
    }
    if caps && layout != "": Text {
        text: "·";
        color: root.ink;
        font-size: root.font-size;
        vertical-alignment: center;
        accessible-role: none;
    }
    if layout != "": Text {
        text: root.layout;
        color: root.ink;
        font-size: root.font-size;
        font-weight: root.font-weight;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

// The on-screen keyboard's button beside a password field: a finger-sized
// target (40 px) round a small keyboard glyph; `active` while it's up.
// It never takes the focus from the field (a TouchArea, no FocusScope)
export component OskButton inherits Rectangle {
    in property <color> ink: Theme.label;
    in property <length> icon-size: 18px;
    in property <bool> active;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: self.height / 2;
    background: t.pressed ? ink.with-alpha(0.2) : active ? ink.with-alpha(0.14) : t.has-hover ? ink.with-alpha(0.08) : transparent;
    animate background { duration: Theme.hover; }
    accessible-role: button;
    accessible-label: active ? "Hide the on-screen keyboard" : "Show the on-screen keyboard";
    accessible-action-default => { root.clicked(); }
    SymIcon {
        text: "\u{e2d8}"; // keyboard
        color: root.ink;
        font-size: root.icon-size;
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
