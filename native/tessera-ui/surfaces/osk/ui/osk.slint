// The on-screen keyboard (src/surfaces/osk; compare
// shell/modules/osk/Keyboard.qml): five rows of keys on a panel at the
// bottom of the screen. It never takes the keyboard; a click types into the
// focused window (Rust sends the key). The keys themselves are core's
// (core/ui/oskgrid.slint), shared with the lock, which draws them on its own
// surface (#763).

import { Theme } from "@tessera/theme.slint";
import { KeyGrid, OskRow } from "@tessera/oskgrid.slint";

export component Keyboard inherits Window {
    in property <[OskRow]> rows;
    in property <length> unit: 58px;
    in property <bool> on-glass;
    callback pressed(int, int);
    callback repeat(int, int);
    property <length> m: 20px;

    background: transparent;
    no-frame: true;
    title: "On-screen keyboard";
    default-font-family: Theme.font;

    Rectangle {
        x: m;
        y: m;
        width: root.width - 2 * m;
        height: root.height - 2 * m;
        border-radius: Theme.material ? 28px : 26px;
        background: on-glass ? transparent : Theme.material ? Theme.panel.with-alpha(Theme.panel-alpha) : Theme.panel;
        border-width: Theme.material || on-glass ? 0 : 0.5px;
        border-color: Theme.separator;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 6px;
        // (none on the plugin's glass: Slint's shadow is a whole box under the
        // see-through glass and darkened it; Glass.qml's is outside only)
        drop-shadow-color: Theme.material ? (Theme.panel-alpha < 1 ? transparent : Theme.dark ? #0000003d : #0000001a) : on-glass ? transparent : (Theme.dark ? #00000031 : #00000015);
    }
    KeyGrid {
        rows: root.rows;
        unit: root.unit;
        pressed(r, c) => { root.pressed(r, c); }
        repeat(r, c) => { root.repeat(r, c); }
    }
}
