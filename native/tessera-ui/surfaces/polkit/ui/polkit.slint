// The authentication dialog, both looks (compare
// shell/modules/polkit/Polkit.qml): a modal dialog over a scrim that doesn't
// dismiss, asking for your password (or a finger) when an app needs admin
// rights. Rust runs the agent and the conversation
// (src/surfaces/polkit/mod.rs); this draws it. The same dialog asks for a
// Bluetooth pairing (`pair`: src/btagent.rs): the device, its code, Pair /
// Cancel, and the field only for a PIN or passkey typed here.

import { CapsHint, OskButton } from "@tessera/password.slint";
import { Theme, Icon } from "@tessera/theme.slint";
import { SymIcon, Symbols } from "@tessera/symbols.slint";

// One row of a request's Details: "Program", "/usr/bin/pkexec"
export struct PkDetail {
    label: string,
    value: string,
}

export component PolkitDialog inherits Window {
    in property <bool> shown;
    in property <string> message;
    in property <string> prompt: "Password";
    in property <bool> secret: true;
    in property <string> error;
    in property <int> error-count;
    in property <bool> waiting;
    in property <bool> finger-wait;
    in property <bool> finger-missed;
    in property <string> user: "your account";
    in property <string> hero; // Material: the hero's shape (0..100 box)
    in property <string> glyph: "\u{e2fe}"; // the hero's glyph (Phosphor; Material maps it)
    // Caps Lock, and the keyboard layout when several are set up (#761);
    // the on-screen keyboard's button beside the field, whether it's up and
    // what it covers, the dialog lifting above it (#763)
    in property <bool> caps;
    in property <string> layout;
    in property <bool> osk-button;
    in property <bool> osk-up;
    in property <length> osk-covers: 360px;
    callback osk();
    // (#760: a password as the field draws it, for its width)
    pure callback mask(string) -> string;
    // Bluetooth pairing: the line under the title, the code shown large,
    // whether the field shows (a PIN or passkey typed here), digits only,
    // the main button (none: Cancel alone), and whether it needs the field
    in property <bool> pair;
    in property <string> detail;
    in property <string> code;
    in property <bool> field-shown: true;
    in property <bool> numeric;
    in property <string> ok-label: "Allow";
    in property <bool> ok-shown: true;
    in property <bool> ok-needs-text: true;
    // which program asks and what it runs (#768), folded until asked for
    in property <[PkDetail]> details;
    in-out property <bool> details-open;
    in-out property <string> text;
    callback submit(string);
    callback cancel();
    background: transparent;
    title: "Authentication";
    default-font-family: Theme.font;

    property <float> progress: shown ? 1 : 0;
    animate progress { duration: Theme.move-emphasized; easing: shown ? (Theme.material ? cubic-bezier(0.05, 0.7, 0.1, 1.0) : cubic-bezier(0.2, 0.9, 0.1, 1.0)) : (Theme.material ? cubic-bezier(0.3, 0, 0.8, 0.15) : cubic-bezier(0.4, 0, 1, 1)); }
    property <length> pad: Theme.material ? 24px : 20px;
    out property <length> body-w: 340px;
    out property <length> body-h: col.preferred-height + 2 * pad;
    out property <length> body-x: (root.width - body-w) / 2 + shake;
    // (never above the screen's top, however long the message; above the
    // on-screen keyboard while it's up)
    out property <length> body-y: max(16px, min((root.height - body-h) / 2 - 40px, osk-up ? root.height - osk-covers - 16px - body-h : root.height));
    out property <float> body-scale: 0.96 + 0.04 * progress;
    out property <float> body-opacity: progress;

    public function focus-field() {
        if finger-wait || !field-shown { fs.focus(); } else { field.focus(); }
    }
    changed finger-wait => { root.focus-field(); }
    changed field-shown => { root.focus-field(); }

    // Shake on a wrong password
    property <duration> t0;
    property <bool> shaking;
    changed error-count => {
        if error != "" {
            t0 = animation-tick();
            shaking = true;
        }
    }
    Timer {
        interval: 280ms;
        running: root.shaking;
        triggered => { root.shaking = false; }
    }
    property <float> k: shaking ? (animation-tick() - t0) / 1ms : 1000;
    property <length> shake: !shaking ? 0px : k < 50 ? 10px * k / 50 : k < 130 ? 10px - 20px * (k - 50) / 80 : k < 200 ? -10px + 16px * (k - 130) / 70 : k < 260 ? 6px - 6px * (k - 200) / 60 : 0px;

    // Modal scrim: blocks the desktop, does not dismiss
    Rectangle {
        background: Theme.material ? Theme.m3-scrim.with-alpha(0.32 * progress) : rgba(0, 0, 0, 0.3 * progress);
        TouchArea { }
    }

    Rectangle {
        x: body-x;
        y: body-y;
        width: body-w;
        height: body-h;
        opacity: body-opacity;
        transform-scale: body-scale;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        border-radius: 28px;
        background: Theme.material ? Theme.m3-surface-container-high : Theme.panel;
        border-width: Theme.material ? 0px : 1px;
        border-color: #ffffff1a;
        accessible-role: none;
        accessible-label: pair ? "Bluetooth pairing" : "Authentication required";
        TouchArea { }
        // (Escape while the field is away, waiting for a finger)
        fs := FocusScope {
            // (a click goes to what's under it: keys only; it covered link rows and choices, which then took two clicks or none)
            focus-on-click: false;
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.cancel();
                    return accept;
                }
                // (a pairing's code to check: Enter pairs)
                if e.text == Key.Return && pair && !field-shown && ok-shown {
                    root.submit("");
                    return accept;
                }
                reject
            }
        }
        col := VerticalLayout {
            x: pad;
            y: pad;
            width: 340px - 2 * pad;
            height: self.preferred-height;
            spacing: Theme.material ? 12px : 10px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: Theme.material ? 64px : 56px;
                    height: self.width;
                    border-radius: 16px;
                    background: Theme.material ? transparent : Theme.toggle-off;
                    if Theme.material: Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: 100;
                        viewbox-height: 100;
                        commands: hero;
                        fill: (finger-wait && finger-missed) || error != "" ? Theme.m3-error-container : Theme.m3-secondary-container;
                        animate fill { duration: Theme.hover; }
                    }
                    if !finger-wait && !Theme.material: Icon { text: glyph; fill: true; font-size: 28px; color: Theme.label; }
                    if !finger-wait && Theme.material: SymIcon { text: glyph; fill: true; font-size: 28px; color: error != "" ? Theme.m3-on-error-container : Theme.m3-on-secondary-container; }
                    if finger-wait && !Theme.material: Icon {
                        text: "\u{e23e}";
                        font-size: 30px;
                        color: finger-missed ? Theme.danger : Theme.accent;
                    }
                    if finger-wait && Theme.material: SymIcon {
                        text: "\u{e23e}";
                        font-size: 30px;
                        color: finger-missed ? Theme.m3-on-error-container : Theme.m3-on-secondary-container;
                    }
                }
            }
            Text {
                horizontal-alignment: center;
                wrap: word-wrap;
                text: message;
                color: Theme.label;
                font-size: Theme.material ? 24px : Theme.title;
                font-weight: Theme.material ? 400 : 600;
            }
            Text {
                horizontal-alignment: center;
                wrap: word-wrap;
                text: pair ? detail
                    : finger-wait && finger-missed ? "Not recognised. Try again, or wait for the password field."
                    : finger-wait ? "Touch the fingerprint reader to allow this. The password field comes back in a few seconds."
                    : "Enter the password for " + user + " to allow this.";
                color: Theme.secondary;
                font-size: Theme.material ? 14px : Theme.small;
            }
            // Details, folded: a row to open, then the program, the command, the action
            if !pair && details.length > 0: Rectangle {
                height: dt.preferred-height + 8px;
                accessible-role: button;
                accessible-label: details-open ? "Hide details" : "Details";
                accessible-action-default => { root.details-open = !root.details-open; }
                dt := HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.details-open ? "Hide details" : "Details";
                        color: Theme.material ? Theme.m3-primary : Theme.accent;
                        font-size: Theme.material ? 14px : Theme.small;
                        font-weight: 500;
                        accessible-role: none;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.details-open = !root.details-open; }
                }
            }
            if !pair && details-open && details.length > 0: Rectangle {
                height: dl.preferred-height + 16px;
                border-radius: Theme.material ? 16px : Theme.radius-control;
                background: Theme.material ? Theme.m3-surface-container-highest : Theme.fill;
                dl := VerticalLayout {
                    x: 12px;
                    y: 8px;
                    width: parent.width - 24px;
                    height: self.preferred-height;
                    spacing: 6px;
                    for d in details: VerticalLayout {
                        spacing: 1px;
                        Text {
                            text: d.label;
                            color: Theme.secondary;
                            font-size: Theme.material ? 12px : Theme.small;
                        }
                        Text {
                            text: d.value;
                            wrap: word-wrap;
                            color: Theme.label;
                            font-family: Theme.mono;
                            font-size: 12px;
                            accessible-label: d.label + ": " + d.value;
                        }
                    }
                }
            }
            // (a pairing's code, large: to check, or to type on the device)
            if code != "": Text {
                horizontal-alignment: center;
                text: code;
                color: Theme.label;
                font-size: Theme.material ? 36px : 32px;
                font-weight: 600;
                letter-spacing: 3px;
                accessible-label: "Code " + code;
            }
            // (always there, hidden while a finger is asked for: it keeps the focus target)
            Rectangle {
                visible: !finger-wait && field-shown;
                height: finger-wait || !field-shown ? 0px : Theme.material ? 52px : 36px;
                border-radius: Theme.material ? 26px : Theme.radius-control;
                background: Theme.material ? Theme.m3-surface-container-highest : Theme.fill;
                border-width: Theme.material ? (field.has-focus || error != "" ? 2px : 0px) : 1px;
                border-color: error != "" ? (Theme.material ? Theme.m3-error : Theme.danger) : field.has-focus ? (Theme.material ? Theme.m3-primary : Theme.accent) : Theme.separator;
                // (#760: the text scrolls with the caret: the input in a
                // clipping box, its end kept in sight; Slint's TextInput
                // doesn't scroll by itself, and a long password's newest
                // dots and caret were cut off)
                pbox := Rectangle {
                    x: Theme.material ? 16px : 12px;
                    width: parent.width - 2 * self.x - (root.osk-button && root.secret ? (Theme.material ? 36px : 28px) : 0px);
                    clip: true;
                    pdots := Text {
                        visible: false;
                        text: root.secret ? root.mask(field.text) : field.text;
                        font-size: Theme.material ? 16px : Theme.body;
                        accessible-role: none;
                    }
                    field := TextInput {
                        x: min(0px, pbox.width - pdots.preferred-width - 4px);
                        width: max(pbox.width, pdots.preferred-width + 4px);
                        height: 100%;
                        vertical-alignment: center;
                        input-type: secret ? InputType.password : numeric ? InputType.number : InputType.text;
                        // (read-only, not disabled: it keeps the focus, so Escape still cancels while "Checking…")
                        read-only: waiting;
                        single-line: true;
                        color: Theme.label;
                        font-size: Theme.material ? 16px : Theme.body;
                        text <=> root.text;
                        accessible-label: prompt;
                        accepted => { root.submit(self.text); }
                        key-pressed(e) => {
                            if e.text == Key.Escape {
                                root.cancel();
                                return accept;
                            }
                            reject
                        }
                    }
                    if root.text == "": Text {
                        x: 0;
                        height: parent.height;
                        vertical-alignment: center;
                        text: prompt;
                        color: Theme.tertiary;
                        font-size: Theme.material ? 16px : Theme.body;
                        accessible-role: none;
                    }
                }
                // The on-screen keyboard's button, at the field's end (#763)
                if root.osk-button && root.secret: OskButton {
                    x: parent.width - self.width - (Theme.material ? 6px : 2px);
                    y: (parent.height - self.height) / 2;
                    width: Theme.material ? 40px : 32px;
                    height: self.width;
                    icon-size: Theme.material ? 18px : 16px;
                    ink: Theme.material ? Theme.m3-on-surface-variant : Theme.secondary;
                    active: root.osk-up;
                    clicked => {
                        field.focus();
                        root.osk();
                    }
                }
            }
            // Caps Lock, and the layout when several are set up (#761)
            if !finger-wait && field-shown && secret && (caps || layout != ""): CapsHint {
                caps: root.caps;
                layout: root.layout;
                ink: Theme.secondary;
                warn: Theme.material ? Theme.m3-on-surface : Theme.label;
                font-size: Theme.material ? 13px : Theme.small;
            }
            if error != "": Text {
                horizontal-alignment: center;
                wrap: word-wrap;
                text: error;
                color: Theme.danger;
                font-size: Theme.small;
                font-weight: 500;
            }
            HorizontalLayout {
                spacing: Theme.material ? 8px : 10px;
                padding-top: Theme.material ? 12px : 6px;
                for b in finger-wait || !ok-shown ? [{ t: "Cancel", p: false }] : [{ t: "Cancel", p: false }, { t: waiting ? "Checking…" : ok-label, p: true }]: Rectangle {
                    property <bool> off: b.p && ok-needs-text && root.text == "";
                    property <color> ink: !Theme.material ? (b.p ? Theme.on-accent : Theme.label)
                        : off ? Theme.m3-on-surface.with-alpha(0.38) : b.p ? Theme.m3-on-primary : Theme.m3-on-secondary-container;
                    property <color> base: off ? Theme.m3-on-surface.with-alpha(0.12) : b.p ? Theme.m3-primary : Theme.m3-secondary-container;
                    height: Theme.material ? 40px : 34px;
                    horizontal-stretch: 1;
                    // (ElasticControl: ~6 %, ≤ 10 px, on springPress)
                    transform-scale: Theme.material && ta.pressed && !off ? 1 + min(0.06, 10px / max(1px, max(self.width, self.height))) : 1;
                    animate transform-scale { duration: Theme.motion(290ms); easing: spring(0.57); }
                    border-radius: Theme.material ? (ta.pressed && !off ? 8px : self.height / 2) : 17px;
                    animate border-radius { duration: Theme.move-spatial; easing: spring(0.4); } // (springFast)
                    background: Theme.material ? (off ? base : base.mix(ink, ta.pressed ? 0.9 : ta.has-hover ? 0.92 : 1))
                        : b.p ? (off ? Theme.accent : ta.pressed ? Theme.accent.darker(0.2) : ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent)
                        : ta.pressed ? Theme.fill-hover.darker(0.1) : ta.has-hover ? Theme.fill-hover : Theme.fill;
                    opacity: !Theme.material && off ? 0.5 : 1;
                    accessible-role: button;
                    accessible-label: b.t;
                    accessible-enabled: !off;
                    accessible-action-default => { if !off { if b.p { root.submit(root.text); } else { root.cancel(); } } }
                    Text {
                        text: b.t;
                        color: ink;
                        font-size: Theme.material ? 14px : Theme.body;
                        font-weight: Theme.material ? 500 : 600;
                    }
                    ta := TouchArea {
                        enabled: !off;
                        mouse-cursor: off ? MouseCursor.default : MouseCursor.pointer;
                        clicked => { if b.p { root.submit(root.text); } else { root.cancel(); } }
                    }
                }
            }
        }
    }
}
