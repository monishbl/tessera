// Search in Rust (rust.surfaces: spotlight), both looks, compare
// shell/modules/spotlight: a transparent full-screen layer with Search's
// view (search.slint: the field, the results, the answer, the web results)
// at its place; a click outside closes it. Rust (src/surfaces/spotlight,
// its controller in search.rs) owns the state; this draws it. The Overview
// draws the same view (surfaces/overview).

import { Theme } from "@tessera/theme.slint";
import { SearchView, SearchState } from "search.slint";

export component SpotlightPanel inherits Window {
    in property <bool> shown;
    out property <float> openness: shown ? 1 : 0;

    // Search's view as Rust reaches it (the same names in the Overview's
    // window: tessera_spotlight::search_view!)
    in-out property <length> search-list-y <=> sv.list-y;
    out property <length> search-list-max: sv.list-max;
    out property <float> search-g-alpha: sv.g-alpha;
    out property <float> search-g-body-alpha: sv.g-body-alpha;
    out property <length> search-g-x: sv.g-x;
    out property <length> search-g-top: sv.g-top;
    out property <length> search-g-w: sv.g-w;
    out property <length> search-g-body-h: sv.g-body-h;
    out property <length> search-g-web-y: sv.g-web-y;
    out property <length> search-g-web-h: sv.g-web-h;
    public function search-open() {
        sv.open();
    }
    public function search-set-text(t: string) {
        sv.set-text(t);
    }
    public function search-set-text-end(t: string) {
        sv.set-text-end(t);
    }
    public function search-focus() {
        sv.focus-field();
    }
    public function search-start-intro() {
        sv.start-intro();
    }

    callback dismissed(); // a click outside
    callback closed(); // the close animation ended

    background: transparent;
    no-frame: true;
    title: "Search";
    default-font-family: Theme.font;

    animate openness {
        // (Material opens on springDefault: ω 19.5, ζ 0.80; closes in popover × 0.7)
        duration: Theme.motion(Theme.material ? (shown ? 322ms : Theme.popover * 0.7) : Theme.popover);
        easing: Theme.material ? (shown ? spring(0.2) : cubic-bezier(0.3, 0, 0.8, 0.15)) : shown ? cubic-bezier(0.2, 0.9, 0.1, 1.0) : cubic-bezier(0.4, 0, 1, 1);
    }
    changed openness => {
        if !shown && openness <= 0.001 { closed(); }
    }

    // Material's scrim
    Rectangle {
        visible: Theme.material;
        background: SearchState.scrim.with-alpha(0.32 * max(0, min(1, openness)));
    }
    // A click outside closes it
    TouchArea {
        enabled: shown;
        clicked => { dismissed(); }
    }

    sv := SearchView {
        width: 100%;
        height: 100%;
        openness: root.openness;
    }
}
