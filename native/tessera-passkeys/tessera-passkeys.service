# Tessera Passkeys: a virtual FIDO2 security key for browsers, SSH and sudo
# (docs/PASSKEYS.md). Installed to ~/.config/systemd/user by Settings when
# Passkeys is turned on (and refreshed by updates while it's on); @BIN@ is
# where Tessera keeps its programs ($XDG_DATA_HOME/tessera/bin).
[Unit]
Description=Tessera Passkeys (virtual security key)
Documentation=file://@DOCS@/PASSKEYS.md
After=graphical-session.target

[Service]
ExecStart=@BIN@/tessera-passkeys
Restart=on-failure
RestartSec=3
# (not NoNewPrivileges: the password check runs PAM's unix_chkpwd, which
# needs its setgid bit)
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
# (no core dump could hold the unsealed wrapping key)
LimitCORE=0

[Install]
WantedBy=default.target
